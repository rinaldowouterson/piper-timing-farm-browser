{
  "name": "piper-timing-farm-browser",
  "version": "1.0.0",
  "description": "High-performance Sovereign Piper TTS engine for the browser with transparent Service Worker integrity gateway.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "piper-farm": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./worker": {
      "import": "./dist/worker.js",
      "types": "./dist/worker.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:vitals": "vitest run .test/vitals.test.ts"
  },
  "dependencies": {
    "@huggingface/hub": "^2.11.0"
  },
  "peerDependencies": {
    "onnxruntime-web": "^1.24.3"
  },
  "author": "Rinaldo Wouterson",
  "license": "MIT",
  "devDependencies": {
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.1",
    "onnxruntime-web": "^1.24.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-static-copy": "^4.0.0",
    "vitest": "^4.1.2"
  }
}
