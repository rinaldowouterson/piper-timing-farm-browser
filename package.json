{
  "name": "piper-timing-farm-browser",
  "version": "1.0.0",
  "description": "Piper TTS engine for the browser with transparent Service Worker integrity verification.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "piper-farm": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./worker": {
      "import": "./dist/process-piper-synthesis.worker.js",
      "types": "./dist/process-piper-synthesis.worker.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rinaldowouterson/piper-timing-farm.git"
  },
  "keywords": [
    "piper",
    "tts",
    "text-to-speech",
    "speech-synthesis",
    "phoneme",
    "phoneme-timing",
    "word-timing",
    "lip-sync",
    "visemes",
    "multithreading",
    "worker-pool",
    "browser",
    "web-worker",
    "service-worker",
    "offline",
    "opfs",
    "onnx",
    "wasm",
    "audio",
    "esm",
    "cli"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build && npx tsx scripts/inject-model-cards-hash.ts && npx tsx scripts/inject-worker-hash.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:vitals": "vitest run .test/vitals.test.ts",
    "test:provision": "npm run build && rm -rf tmp-test-provision && mkdir tmp-test-provision && cd tmp-test-provision && touch package.json && node ../dist/cli.js init && node ../dist/cli.js init custom-target && cd ..",
    "prepublishOnly": "npx tsx scripts/verify-release-readiness.ts"
  },
  "dependencies": {
    "@huggingface/hub": "^2.11.0"
  },
  "author": "Rinaldo Wouterson",
  "license": "MIT",
  "devDependencies": {
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.1",
    "onnxruntime-web": "^1.24.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-static-copy": "^4.0.0",
    "vitest": "^4.1.2"
  }
}
