{
  "name": "piper-timing-farm",
  "version": "1.0.0",
  "description": "Framework-agnostic Piper TTS worker farm with worker-thread callbacks.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "piper-farm": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./worker": {
      "import": "./dist/worker.js",
      "types": "./dist/worker/index.d.ts"
    },
    "./cdn": {
      "import": "./dist/index-cdn.js",
      "types": "./dist/index-cdn.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build && tsc --emitDeclarationOnly",
    "postbuild": "chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:vitals": "vitest run .test/vitals.test.ts"
  },
  "dependencies": {
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "onnxruntime-web": "^1.24.3",
    "vite-plugin-static-copy": "^4.0.0"
  },
  "author": "Rinaldo Wouterson",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
